# Derived index and local captures. Approved memory documents are the
# source of truth; the vector database is rebuilt from them.
data/

# Session captures and transcripts. These can contain secrets and
# unredacted conversation. Review happens before anything is kept.
inbox/
transcripts/

# Approved memories. They stay on this machine and are not published.
# The source of truth is data/memories.sqlite. memories/ is only the old JSON folder.
memories/
memories.imported/

# Bytecode from local runs of the CLI.
__pycache__/
*.pyc

# Local configuration and credentials.
.env
.env.*
!.env.example
