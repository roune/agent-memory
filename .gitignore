# The server's store (data/server), Qdrant's (data/qdrant), the old laptop
# store that migrate reads (data/memories.sqlite), and local captures.
data/

# Session captures and transcripts. These can contain secrets and
# unredacted conversation. Review happens before anything is kept.
inbox/
transcripts/

# Bytecode from local runs of the CLI.
__pycache__/
*.pyc

# Package builds (uv build, uv tool install).
build/
dist/
*.egg-info/

# Local configuration and credentials.
.env
.env.*
!.env.example

# Approved requests waiting for the server (agent-memory sync sends them).
outbox/
