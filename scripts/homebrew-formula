#!/usr/bin/env python3
"""Render the Homebrew formula for one sdist. Standard library only.

    scripts/homebrew-formula --url <sdist url> --sha256 <hex> [--out Formula/agent-memory.rb]
    scripts/homebrew-formula --local --url file:///tmp/dist/roune_agent_memory-0.1.0.tar.gz --sha256 <hex>

The template is packaging/homebrew/agent-memory.rb. Only its url and sha256
lines change; every other byte stays. The release job renders it with the
sdist PyPI serves and opens a PR on roune/homebrew-tap; test.yml's homebrew
job renders it with a file:// URL to a fresh sdist and installs it.

Homebrew reads the version from the file name, so the URL must end in
roune_agent_memory-<version>.tar.gz. A file:// URL needs --local, so a
release can't ship one by mistake.
"""

import argparse
import re
import sys
from pathlib import Path
from urllib.parse import urlsplit

ROOT = Path(__file__).resolve().parents[1]
TEMPLATE = ROOT / "packaging" / "homebrew" / "agent-memory.rb"

URL_LINE = re.compile(r'^  url "[^"\n]*"$', re.MULTILINE)
SHA256_LINE = re.compile(r'^  sha256 "[^"\n]*"$', re.MULTILINE)
SHA256 = re.compile(r"[0-9a-f]{64}")
SDIST_NAME = re.compile(r"roune_agent_memory-[0-9][0-9A-Za-z.]*\.tar\.gz")


def check_url(url, local):
    """The URL, or SystemExit saying why it can't go into the formula."""
    parts = urlsplit(url)
    if parts.scheme == "file":
        if not local:
            raise SystemExit(f"{url}: a file:// URL needs --local")
    elif parts.scheme != "https" or not parts.netloc:
        raise SystemExit(f"{url}: the url must be https://")
    if '"' in url or "\\" in url or any(ch.isspace() for ch in url):
        raise SystemExit(f"{url}: the url can't hold quotes, backslashes or spaces")
    name = parts.path.rsplit("/", 1)[-1]
    if not SDIST_NAME.fullmatch(name):
        raise SystemExit(f"{url}: the file must be roune_agent_memory-<version>.tar.gz, so Homebrew reads the version")
    return url


def check_sha256(value):
    if not SHA256.fullmatch(value):
        raise SystemExit(f"{value!r}: the sha256 must be 64 lowercase hex digits")
    return value


def replace_once(pattern, line, text, what):
    found = pattern.findall(text)
    if len(found) != 1:
        raise SystemExit(f"{TEMPLATE}: expected one {what} line, found {len(found)}")
    return pattern.sub(lambda _match: line, text)


def render(template, url, sha256):
    text = replace_once(URL_LINE, f'  url "{url}"', template, "url")
    return replace_once(SHA256_LINE, f'  sha256 "{sha256}"', text, "sha256")


def main(argv=None):
    parser = argparse.ArgumentParser(description="Render the Homebrew formula for one sdist.")
    parser.add_argument("--url", required=True, help="the sdist's URL, https://")
    parser.add_argument("--sha256", required=True, help="the sdist's sha256, 64 hex digits")
    parser.add_argument("--local", action="store_true", help="allow a file:// URL, for a test install")
    parser.add_argument("--out", type=Path, help="write here instead of stdout")
    args = parser.parse_args(argv)
    url = check_url(args.url, args.local)
    sha256 = check_sha256(args.sha256)
    formula = render(TEMPLATE.read_text(), url, sha256)
    if args.out:
        args.out.write_text(formula)
    else:
        sys.stdout.write(formula)
    return 0


if __name__ == "__main__":
    sys.exit(main())
