#!/usr/bin/env python3
"""Check that a release tag matches the version everything else pins. Standard library only.

    scripts/release-check v0.1.0     # exit 0 and print 0.1.0, or exit 1 and say what differs
    scripts/release-check --version  # print the version in pyproject.toml

The tag must be v<version>, with the version from pyproject.toml, and
compose.yaml and compose.team.yaml must default to
ghcr.io/roune/agent-memory-server:<version>. The copy of compose.yaml that the
wheel carries, scripts/agent_memory_assets/compose.yaml, must pin the same
version and be byte-for-byte the root file. The release workflow runs it before
it builds anything, and CI runs it on every PR with the current version, so a
version bump that misses a compose file fails there first.
"""

import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(Path(__file__).resolve().parent))
# The pin's pattern is shared with `agent-memory setup`, which reads it from the installed package.
from agent_memory_assets import IMAGE, pins  # noqa: E402

COMPOSE_FILES = ("compose.yaml", "compose.team.yaml", "scripts/agent_memory_assets/compose.yaml")
PACKAGED = "scripts/agent_memory_assets/compose.yaml"


def version(root=ROOT):
    with open(Path(root) / "pyproject.toml", "rb") as handle:
        return tomllib.load(handle)["project"]["version"]


def problems(tag, root=ROOT):
    root = Path(root)
    expected = version(root)
    found = []
    if tag != f"v{expected}":
        found.append(f"the tag is {tag}, but pyproject.toml says version {expected}: tag v{expected}")
    for name in COMPOSE_FILES:
        if not (root / name).is_file():
            found.append(f"{name} is missing")
            continue
        found_pins = pins((root / name).read_text(encoding="utf-8"))
        if found_pins != [expected]:
            shown = ", ".join(found_pins) or "none"
            found.append(f"{name} pins {IMAGE} at {shown}; it should pin {expected}")
    if (root / PACKAGED).is_file() and (root / "compose.yaml").is_file() and (root / PACKAGED).read_bytes() != (root / "compose.yaml").read_bytes():
        found.append(f"{PACKAGED} differs from compose.yaml; copy it: cp compose.yaml {PACKAGED}")
    return found


def main(argv):
    if argv == ["--version"]:
        print(version())
        return 0
    if len(argv) != 1 or argv[0].startswith("-"):
        print("usage: scripts/release-check v<version> | --version", file=sys.stderr)
        return 2
    found = problems(argv[0])
    for line in found:
        print(line, file=sys.stderr)
    if found:
        return 1
    print(version())
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
