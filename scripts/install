#!/bin/sh
# Put the agent-memory command on PATH from this clone: uv tool install --editable.
# Changes in the clone take effect without installing again. Extra arguments
# go to uv, for example --force.
#
# Does not write editor hooks. Hook setup is a second step: agent-memory
# install, which asks first.

set -eu

self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done

root=$(CDPATH= cd -- "$(dirname "$self")/.." && pwd)

if ! command -v uv >/dev/null 2>&1; then
  echo "scripts/install needs uv: https://docs.astral.sh/uv/getting-started/installation/" >&2
  exit 1
fi

bin_dir=$(uv tool dir --bin)
dest="$bin_dir/agent-memory"

# Before the tool install, this script linked $dest to a clone's
# bin/agent-memory. uv won't replace a file it didn't write, so that old link
# goes first. Anything else at $dest is left for uv to report.
if [ -L "$dest" ]; then
  target=$(readlink "$dest")
  case $target in
    /*) resolved=$target ;;
    *) resolved="$bin_dir/$target" ;;
  esac
  case $resolved in
    */bin/agent-memory)
      clone=$(dirname "$(dirname "$resolved")")
      if [ -f "$clone/scripts/agent_memory.py" ]; then
        rm "$dest"
        echo "Removed the old link $dest -> $target"
      fi
      ;;
  esac
fi

uv tool install --editable "$root" "$@"

echo
echo "agent-memory now runs this clone's code: $root"
echo "Next, connect the editors you want. This asks before it writes anything,"
echo "and points hooks an older install wrote at the new command:"
echo "  agent-memory install"

case ":$PATH:" in
  *":$bin_dir:"*) ;;
  *)
    echo
    echo "$bin_dir is not on PATH in this shell. Run \`uv tool update-shell\`, or add it:"
    echo "  export PATH=\"$bin_dir:\$PATH\""
    ;;
esac
