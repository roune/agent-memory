#!/bin/sh
# Embed pending SQLite rows into Qdrant.
# The URL comes from ~/.config/agent-memory/database.
# The default is http://127.0.0.1:6333. Fetches the pinned ONNX checkpoint on first run.

set -eu

cd "$(dirname "$0")/.."

exec uv run --python 3.12 --with "fastembed==0.9.1" python scripts/embed.py "$@"
