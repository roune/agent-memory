#!/bin/sh
# Create data/qdrant and start the Qdrant server. No account, no client library.
# The embed step talks to http://127.0.0.1:6333. It does not open this directory.

set -eu

cd "$(dirname "$0")/.."

if ! command -v docker >/dev/null 2>&1; then
  echo "docker is required to start Qdrant" >&2
  exit 1
fi

mkdir -p data/qdrant

docker compose up -d

i=0
while [ "$i" -lt 60 ]; do
  if curl -fsS "http://127.0.0.1:6333/readyz" >/dev/null 2>&1; then
    echo "Qdrant is ready at http://127.0.0.1:6333"
    exit 0
  fi
  i=$((i + 1))
  sleep 1
done

echo "Qdrant did not become ready. Recent logs:" >&2
docker compose logs --tail 40 qdrant >&2
exit 1
